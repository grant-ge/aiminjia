# Generated by Cargo
# will have compiled files and executables
/target/
/gen/schemas

# Bundled Python runtime (downloaded by scripts/setup-python.sh)
# Ignore contents but keep the directory (Tauri needs it for bundle.resources validation)
/python-runtime/*
!/python-runtime/.gitkeep

# Copied at build time from lotus/code/home/changelog.json
/changelog.json

# Generated by build.rs from capabilities-e2e/pilot.json when --features e2e
# is enabled. Source of truth lives in capabilities-e2e/.
/capabilities/pilot.json

# E2E wrapper crate target dir (independent from main /target/)
/.e2e/target/
