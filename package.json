  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node -e \"fetch('https://ai.renlijia.com/changelog.json').then(r=>r.ok?r.text():'{\\\"versions\\\":[]}').catch(()=>'{\\\"versions\\\":[]}').then(t=>require('fs').writeFileSync('src-tauri/changelog.json',t))\"",
