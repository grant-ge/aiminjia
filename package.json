    "updater:intent:serve": "node scripts/dev-updater-intent-mock.mjs --serve-only",
    "dev:updater-intent": "node scripts/dev-updater-intent-mock.mjs --tauri",
    "build:with-pilot": "VITE_E2E_ENABLED=true tauri build --features e2e --config src-tauri/tauri.conf.e2e.json",
