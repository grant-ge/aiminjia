{
  "purchase": {
    "必备条款": [
      {"clause": "合同主体", "elements": ["甲乙方全称", "统一社会信用代码", "法定代表人", "地址"], "common_defect": "仅写简称无法定代表人"},
      {"clause": "标的物描述", "elements": ["品名规格", "数量", "质量标准", "验收方法"], "common_defect": "规格描述模糊无验收标准"},
      {"clause": "价款支付", "elements": ["金额", "支付方式", "支付时间", "发票要求"], "common_defect": "未约定付款逾期违约金"},
      {"clause": "交付方式", "elements": ["交货时间", "交货地点", "运输方式", "风险转移"], "common_defect": "未明确风险转移节点"},
      {"clause": "违约责任", "elements": ["违约情形", "违约金比例", "赔偿范围", "免责条款"], "common_defect": "违约金无上限或过低"},
      {"clause": "争议解决", "elements": ["协商→调解→仲裁/诉讼", "管辖法院/仲裁机构"], "common_defect": "同时约定仲裁和诉讼导致条款无效"}
    ]
  },
  "service": {
    "必备条款": [
      {"clause": "服务范围", "elements": ["服务内容", "交付标准", "服务期限"], "common_defect": "服务范围过于宽泛无边界"},
      {"clause": "知识产权归属", "elements": ["成果归属", "授权范围", "侵权责任"], "common_defect": "未约定导致归属争议"},
      {"clause": "保密条款", "elements": ["保密信息定义", "保密期限", "违约责任"], "common_defect": "保密信息定义过窄"}
    ]
  },
  "labor": {
    "必备条款": [
      {"clause": "工作岗位", "elements": ["岗位名称", "工作内容", "工作地点"], "common_defect": "岗位描述过于宽泛便于调岗"},
      {"clause": "薪酬待遇", "elements": ["基本工资", "绩效奖金", "加班费", "社保公积金"], "common_defect": "薪酬结构不清晰"},
      {"clause": "竞业限制", "elements": ["限制范围", "限制期限", "补偿标准"], "common_defect": "有竞业限制无补偿金约定（可能无效）"}
    ]
  },
  "nda": {
    "必备条款": [
      {"clause": "保密信息定义", "elements": ["明确列举", "标记要求", "例外情形"], "common_defect": "定义过于宽泛或过窄"},
      {"clause": "保密期限", "elements": ["合同期内+合同终止后N年"], "common_defect": "无期限约定或期限过长"}
    ]
  }
}
